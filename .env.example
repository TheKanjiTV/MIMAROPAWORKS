# Use this exact origin in your browser and Google authorized JavaScript origins.
APP_ORIGIN=http://127.0.0.1:5173
API_PORT=3001

# Local FastAPI semantic service. Leave blank to retain text-overlap fallback.
AI_SERVICE_URL=http://127.0.0.1:8000

# Public Google OAuth Web client ID; never put a client secret in a VITE variable.
# Set both to the same value. The server also accepts VITE_GOOGLE_CLIENT_ID as fallback.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Preview mode requires Brevo, Resend AND SMTP to be unconfigured.
# Clear the illustrative BREVO_API_KEY and BREVO_SENDER_EMAIL below for preview mode.
# Provider exceptions are retried; they do not automatically switch to preview.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Brevo is the primary transactional provider. Verify this sender in Brevo first.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=MIMAROPA Jobs

# Legacy fallback only. Resend remains supported until every deployment has moved to Brevo.
RESEND_API_KEY=

# Default: MySQL (start MySQL before running migrations)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=innohack
DB_USERNAME=root
DB_PASSWORD=

# Alternative: SQLite (comment the MySQL block above, then uncomment these)
#DB_CONNECTION=sqlite
#DB_DATABASE=server/data/innohack.sqlite
# SQLite uses a file; DB_HOST, DB_PORT, DB_USERNAME and DB_PASSWORD are not needed.
