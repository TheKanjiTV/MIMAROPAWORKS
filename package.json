{
  "name": "mimaropa-works",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src",
    "test": "node --test server/*.test.mjs",
    "format:check": "prettier --check src index.html vite.config.ts",
    "dev:api": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "admin:create": "node server/create-admin.mjs",
    "admin:promote": "node server/promote-admin.mjs",
    "demo:employers": "node server/seed-demo-employers.mjs",
    "db:create": "node server/db-cli.mjs create",
    "db:migrate": "node server/db-cli.mjs migrate",
    "db:status": "node server/db-cli.mjs status",
    "test:mysql": "node server/test-mysql.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@getbrevo/brevo": "^6.0.3",
    "@react-oauth/google": "^0.13.5",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.3.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.0"
  }
}
